DATABASE_URL=postgres://postgres:postgres@localhost:5432/index
TRONGRID_API_KEY=
ALERT_WEBHOOK_URL=
HEALTHCHECK_PING_URL=
PUBLISH=off
PUBLIC_DIR=public
PORT=3000
# Collect-only venues: their terms restrict reproducing their data. Off (the default) stores their quotes and never
# counts or publishes them; on counts and publishes them. Read the venue's terms before turning one on.
PUBLISH_ITRX=off
PUBLISH_TRONENERGY_MARKET=off
PUBLISH_TOKENGOODIES=off
NETTS_API_KEY=
# Optional: the wallets file the hour job reads into `verification` after each print (supplier and top-100 lists;
# see docs/verification/wallets.example.json). It names the supplier's wallets: never commit it, never paste it into a variable.
VERIFY_WALLETS_FILE=
# Optional: TronGrid requests a second for those reads, a whole number from 1 to 10; unset means 2.
VERIFY_RPS=
